<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:dashb="http://jmix.io/schema/vaadin-dashboard/ui"
      title="msg://dashboardProgrammaticView.title">
    <layout>
        <hbox id="buttonsPanel">
            <button id="addWidgetBtn" text="msg://addWidgetBtn.text"/>
            <button id="addSectionBtn" text="msg://addSectionBtn.text"/>
            <button id="clearBtn" text="msg://clearBtn.text"/>
        </hbox>

        <dashb:dashboard id="dashboard" width="100%" minimumColumnWidth="16em"/>
    </layout>
</view>
