<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:dashb="http://jmix.io/schema/vaadin-dashboard/ui"
      title="msg://dashboardGridView.title">
    <layout>
        <hbox id="buttonsPanel">
            <button id="compactBtn" text="msg://compactBtn.text"/>
        </hbox>

        <!-- tag::grid[] -->
        <dashb:dashboard id="dashboard"
                         width="100%"
                         maximumColumnCount="4"
                         minimumColumnWidth="18em"
                         maximumColumnWidth="32em"
                         minimumRowHeight="12em"
                         gap="1em"
                         padding="1em"
                         denseLayout="true"
                         themeNames="shaded-background elevated-widgets">
            <!-- end::grid[] -->
            <dashb:dashboardWidget id="widget1" title="msg://widget1.title">
                <dashb:content>
                    <h3 id="value1" text="1,204,500"/>
                </dashb:content>
            </dashb:dashboardWidget>
            <dashb:dashboardWidget id="widget2" title="msg://widget2.title" colspan="2">
                <dashb:content>
                    <h3 id="value2" text="3,182"/>
                </dashb:content>
            </dashb:dashboardWidget>
            <dashb:dashboardWidget id="widget3" title="msg://widget3.title">
                <dashb:content>
                    <h3 id="value3" text="612,100"/>
                </dashb:content>
            </dashb:dashboardWidget>
            <dashb:dashboardWidget id="widget4" title="msg://widget4.title">
                <dashb:content>
                    <h3 id="value4" text="592,400"/>
                </dashb:content>
            </dashb:dashboardWidget>
        </dashb:dashboard>
    </layout>
</view>
