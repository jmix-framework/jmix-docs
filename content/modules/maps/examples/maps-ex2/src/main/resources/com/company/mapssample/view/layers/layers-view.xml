<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:maps="http://jmix.io/schema/maps/ui"
      title="msg://layersView.title">
    <layout>
        <tabSheet width="100%" height="100%">
            <tab id="tab1" label="TL.OsmSource">
                <!-- tag::osmSource[] -->
                <maps:geoMap id="map"
                             height="100%"
                             width="100%">
                    <maps:layers>
                        <maps:tile>
                            <maps:osmSource/>
                        </maps:tile>
                    </maps:layers>
                </maps:geoMap>
                <!-- end::osmSource[] -->
            </tab>
            <tab id="tab2" label="TL.XyzSource">
                <!-- tag::xyzSource[] -->
                <maps:geoMap id="mapxyz"
                             width="100%"
                             height="100%">
                    <maps:layers>
                        <maps:tile>
                            <maps:xyzSource
                                    url="https://tile.thunderforest.com/cycle/{z}/{x}/{y}.png?apikey=YOUR_API_KEY">
                            </maps:xyzSource>
                        </maps:tile>
                    </maps:layers>
                </maps:geoMap>
                <!-- end::xyzSource[] -->
            </tab>
            <tab id="tab3" label="TL.ArcGIS XyzSource">
                <maps:geoMap id="mapxyz2"
                             width="100%"
                             height="100%">
                    <maps:layers>
                        <maps:tile>
                            <maps:xyzSource
                                    url="https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}">
                            </maps:xyzSource>
                        </maps:tile>
                    </maps:layers>
                </maps:geoMap>
            </tab>
            <tab id="tab4" label="TL.WmsSource">
                <!-- tag::wmsSource[] -->
                <maps:geoMap id="mapwms"
                             width="100%"
                             height="100%">
                    <maps:layers>
                        <maps:tile>
                            <maps:tileWmsSource url="https://ahocevar.com/geoserver/wms"
                                                serverType="GEO_SERVER">
                                <maps:parameters>
                                    <maps:parameter name="LAYERS" value="topp:states"/>
                                    <maps:parameter name="TILED" value="true"/>
                                </maps:parameters>
                            </maps:tileWmsSource>
                        </maps:tile>
                    </maps:layers>
                </maps:geoMap>
                <!-- end::wmsSource[] -->
            </tab>
            <tab id="tab10" label="TL.WmtsSource">
                <!-- tag::wmtsSource[] -->
                <maps:geoMap id="mapWmts"
                             width="100%"
                             height="100%">
                    <maps:mapView centerX="0" centerY="0" zoom="2"/>
                    <maps:layers>
                        <maps:tile>
                            <maps:wmtsSource url="https://gibs.earthdata.nasa.gov/wmts/epsg3857/best/wmts.cgi"
                                             layer="BlueMarble_ShadedRelief_Bathymetry"
                                             matrixSet="GoogleMapsCompatible_Level8"
                                             format="image/jpeg"
                                             style="default"
                                             requestEncoding="KVP">
                                <maps:projection code="EPSG:3857"/>
                                <maps:tileGrid resolutions="156543.03392804097, 78271.51696402048, 39135.75848201024"
                                               matrixIds="0, 1, 2">
                                    <maps:origin x="-20037508.342789244" y="20037508.342789244"/>
                                    <maps:tileSize width="256" height="256"/>
                                </maps:tileGrid>
                            </maps:wmtsSource>
                        </maps:tile>
                    </maps:layers>
                </maps:geoMap>
                <!-- end::wmtsSource[] -->
            </tab>
            <tab id="tab11" label="TL.WmtsSource Web Mercator">
                <!-- tag::wmtsWebMercatorSource[] -->
                <maps:geoMap id="mapWmtsWebMercator"
                             width="100%"
                             height="100%">
                    <maps:mapView centerX="0" centerY="0" zoom="4"/>
                    <maps:layers>
                        <maps:tile>
                            <maps:wmtsSource url="https://gibs.earthdata.nasa.gov/wmts/epsg3857/best/wmts.cgi"
                                             layer="BlueMarble_ShadedRelief_Bathymetry"
                                             matrixSet="GoogleMapsCompatible_Level8"
                                             format="image/jpeg"
                                             style="default">
                                <maps:webMercatorTileGrid maxZoom="8"
                                                          numericMatrixIds="true"/>
                            </maps:wmtsSource>
                        </maps:tile>
                    </maps:layers>
                </maps:geoMap>
                <!-- end::wmtsWebMercatorSource[] -->
            </tab>
            <tab id="tab12" label="TL.WmtsSource Capabilities">
                <!-- tag::wmtsCapabilitiesSource[] -->
                <maps:geoMap id="mapWmtsCapabilities"
                             width="100%"
                             height="100%">
                    <maps:mapView centerX="0" centerY="0" zoom="4"/>
                    <maps:layers>
                        <maps:tile>
                            <maps:wmtsSource url="https://gibs.earthdata.nasa.gov/wmts/epsg3857/best/wmts.cgi"
                                             layer="BlueMarble_ShadedRelief_Bathymetry">
                                <maps:capabilities url="https://gibs.earthdata.nasa.gov/wmts/epsg3857/best/1.0.0/WMTSCapabilities.xml"/>
                            </maps:wmtsSource>
                        </maps:tile>
                    </maps:layers>
                </maps:geoMap>
                <!-- end::wmtsCapabilitiesSource[] -->
            </tab>
            <tab id="tab5" label="IL.ImageStaticSource">
                <!-- tag::imagestatic[] -->
                <maps:geoMap id="mapimagestatic"
                             width="100%"
                             height="100%">
                    <maps:mapView centerX="512" centerY="479" zoom="2">
                        <maps:projection code="static-image"
                                         units="PIXELS">
                            <maps:extent minX="0" minY="0" maxX="1024" maxY="968"/>
                        </maps:projection>
                    </maps:mapView>
                    <maps:layers>
                        <maps:image id="imageLayer">
                            <maps:imageStaticSource url="https://imgs.xkcd.com/comics/online_communities.png">
                                <maps:projection code="static-image"/>
                                <maps:imageExtent minX="0" minY="0" maxX="1024" maxY="968"/>
                            </maps:imageStaticSource>
                        </maps:image>
                    </maps:layers>
                </maps:geoMap>
                <!-- end::imagestatic[] -->
            </tab>
            <tab id="tab6" label="IL.Image from classpath">
                <!-- tag::imagestatic-classpath[] -->
                <maps:geoMap id="declarativeMap"
                             width="100%"
                             height="100%">
                    <maps:mapView centerX="450" centerY="522" zoom="2">
                        <maps:projection code="static-image"
                                         units="PIXELS">
                            <maps:extent minX="0" minY="0" maxX="900" maxY="1044"/>
                        </maps:projection>
                    </maps:mapView>
                    <maps:layers>
                        <maps:image id="dImageLayer">
                            <maps:imageStaticSource id="classpathSource"
                                                    url="maps/map.png">
                                <maps:projection code="static-image"/>
                                <maps:imageExtent minX="0" minY="0" maxX="900" maxY="1044"/>
                            </maps:imageStaticSource>
                        </maps:image>
                    </maps:layers>
                </maps:geoMap>
                <!-- end::imagestatic-classpath[] -->
            </tab>
            <tab id="tab7" label="IL.ProgrammaticImage">
                <maps:geoMap id="programmaticMap"
                             width="100%"
                             height="100%">
                    <maps:mapView centerX="450" centerY="522" zoom="2">
                        <maps:projection code="static-image"
                                         units="PIXELS">
                            <maps:extent minX="0" minY="0" maxX="900" maxY="1044"/>
                        </maps:projection>
                    </maps:mapView>
                    <maps:layers>
                        <maps:image id="pImageLayer">
                            <maps:imageStaticSource id="programmaticSource">
                                <maps:projection code="static-image"/>
                                <maps:imageExtent minX="0" minY="0" maxX="900" maxY="1044"/>
                            </maps:imageStaticSource>
                        </maps:image>
                    </maps:layers>
                </maps:geoMap>
            </tab>
            <tab id="tab8" label="IL.ImageWmsSource">
                <!-- tag::imageWmsSource[] -->
                <maps:geoMap id="mapimagewms"
                             width="100%"
                             height="100%">
                    <maps:layers>
                        <maps:tile>
                            <maps:osmSource/>
                        </maps:tile>
                        <maps:image>
                            <maps:imageWmsSource url="https://ahocevar.com/geoserver/wms"
                                                 ratio="1"
                                                 serverType="GEO_SERVER">
                                <maps:parameters>
                                    <maps:parameter name="LAYERS" value="topp:states"/>
                                </maps:parameters>
                            </maps:imageWmsSource>
                            <maps:extent minX="-124.43" minY="24.57" maxX="-66.58" maxY="49.22"/>
                        </maps:image>
                    </maps:layers>
                </maps:geoMap>
                <!-- end::imageWmsSource[] -->
            </tab>
            <tab id="tab9" label="VL.VectorSource">
                <!-- tag::vectorSource[] -->
                <maps:geoMap id="mapwithvector"
                             width="100%"
                             height="100%">
                    <maps:layers>
                        <maps:tile>
                            <maps:osmSource/>
                        </maps:tile>
                        <maps:vector id="vectorLayer">
                            <maps:vectorSource id="vectorSource"/>
                        </maps:vector>
                    </maps:layers>
                </maps:geoMap>
                <!-- end::vectorSource[] -->
            </tab>
        </tabSheet>
    </layout>
</view>