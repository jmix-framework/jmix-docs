<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:maps="http://jmix.io/schema/maps/ui"
      title="msg://mapComponentView.title">
    <layout>
        <!-- tag::extentConstraintOptions[] -->
        <maps:geoMap id="map"
                     width="100%"
                     height="340px">
            <maps:mapView centerX="7"
                          centerY="7"
                          zoom="7"
                          showFullExtent="true">
                <maps:extent minX="5"
                             minY="0"
                             maxX="20"
                             maxY="15"/>
            </maps:mapView>
            <maps:layers>
                <maps:tile>
                    <maps:osmSource/>
                </maps:tile>
            </maps:layers>
        </maps:geoMap>
        <!-- end::extentConstraintOptions[] -->
    </layout>
</view>