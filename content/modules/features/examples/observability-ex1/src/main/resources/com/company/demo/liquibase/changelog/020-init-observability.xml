<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1" author="demo">
        <createTable tableName="OWNER">
            <column name="ID" type="${uuid.type}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="VERSION" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="NAME" type="varchar(255)"/>
        </createTable>

        <createTable tableName="PET">
            <column name="ID" type="${uuid.type}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="VERSION" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="NAME" type="varchar(255)"/>
            <column name="OWNER_ID" type="${uuid.type}"/>
        </createTable>

        <createTable tableName="VISIT">
            <column name="ID" type="${uuid.type}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="VERSION" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="PET_ID" type="${uuid.type}">
                <constraints nullable="false"/>
            </column>
            <column name="VISIT_START" type="timestamp"/>
        </createTable>

        <createTable tableName="ORDER_">
            <column name="ID" type="${uuid.type}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="VERSION" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="NUMBER_" type="varchar(255)"/>
            <column name="CHANNEL" type="varchar(255)"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="PET" baseColumnNames="OWNER_ID" constraintName="FK_PET_ON_OWNER"
                                 referencedTableName="OWNER" referencedColumnNames="ID"/>
        <addForeignKeyConstraint baseTableName="VISIT" baseColumnNames="PET_ID" constraintName="FK_VISIT_ON_PET"
                                 referencedTableName="PET" referencedColumnNames="ID"/>

        <createIndex tableName="PET" indexName="IDX_PET_OWNER">
            <column name="OWNER_ID"/>
        </createIndex>
        <createIndex tableName="VISIT" indexName="IDX_VISIT_PET">
            <column name="PET_ID"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
