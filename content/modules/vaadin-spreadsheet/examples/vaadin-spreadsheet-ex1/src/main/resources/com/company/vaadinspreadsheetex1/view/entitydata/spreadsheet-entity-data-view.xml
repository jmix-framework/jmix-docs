<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:sprd="http://jmix.io/schema/vaadin-spreadsheet/ui"
      title="msg://spreadsheetEntityDataView.title">
    <data>
        <collection id="usersDc" class="com.company.vaadinspreadsheetex1.entity.User">
            <fetchPlan extends="_base"/>
            <loader id="usersDl">
                <query>
                    <![CDATA[select e from User e order by e.username]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <layout expand="spreadsheet">
        <hbox id="buttonsPanel">
            <button id="saveBtn" text="msg://saveBtn.text" icon="CHECK" themeNames="primary"/>
        </hbox>
        <sprd:spreadsheet id="spreadsheet" width="100%"/>
    </layout>
</view>
