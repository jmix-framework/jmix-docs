<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:sprd="http://jmix.io/schema/vaadin-spreadsheet/ui"
      title="msg://spreadsheetCellsView.title">
    <layout expand="spreadsheet">
        <hbox id="buttonsPanel">
            <button id="updateBtn" text="msg://updateBtn.text"/>
            <button id="styleBtn" text="msg://styleBtn.text"/>
        </hbox>
        <sprd:spreadsheet id="spreadsheet" width="100%"/>
    </layout>
</view>
