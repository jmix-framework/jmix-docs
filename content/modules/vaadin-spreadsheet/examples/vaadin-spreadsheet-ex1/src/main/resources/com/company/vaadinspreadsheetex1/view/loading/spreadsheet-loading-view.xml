<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:sprd="http://jmix.io/schema/vaadin-spreadsheet/ui"
      title="msg://spreadsheetLoadingView.title">
    <facets>
        <settings auto="true"/>
    </facets>
    <layout expand="spreadsheet">
        <hbox id="buttonsPanel">
            <button id="downloadBtn" text="msg://downloadBtn.text" icon="DOWNLOAD" themeNames="primary"/>
        </hbox>
        <sprd:spreadsheet id="spreadsheet" width="100%" chartsEnabled="true"/>
    </layout>
</view>
