<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:sprd="http://jmix.io/schema/vaadin-spreadsheet/ui"
      title="msg://spreadsheetSheetsView.title">
    <layout expand="spreadsheet">
        <hbox id="buttonsPanel">
            <button id="addSheetBtn" text="msg://addSheetBtn.text"/>
            <button id="deleteSheetBtn" text="msg://deleteSheetBtn.text"/>
        </hbox>
        <sprd:spreadsheet id="spreadsheet" width="100%"/>
    </layout>
</view>
