<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1" author="onboarding">
        <dropForeignKeyConstraint baseTableName="USER_HOBBY_LINK" constraintName="FK_USEHOB_ON_HOBBY"/>
    </changeSet>
    <changeSet id="2" author="onboarding">
        <dropForeignKeyConstraint baseTableName="USER_HOBBY_LINK" constraintName="FK_USEHOB_ON_USER"/>
    </changeSet>
    <changeSet id="3" author="onboarding">
        <createTable tableName="ORDER_REPORT">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_ORDER_REPORT"/>
            </column>
            <column name="NAME" type="VARCHAR(255)"/>
            <column name="CODE" type="CLOB"/>
        </createTable>
    </changeSet>
    <changeSet id="4" author="onboarding">
        <dropTable cascadeConstraints="true" tableName="USER_HOBBY_LINK"/>
    </changeSet>
</databaseChangeLog>