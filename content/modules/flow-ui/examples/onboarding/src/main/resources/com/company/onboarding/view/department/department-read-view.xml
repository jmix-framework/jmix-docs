<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://departmentReadView.title"
      focusComponent="form">
    <data>
        <instance id="departmentDc"
                  class="com.company.onboarding.entity.Department">
            <fetchPlan extends="_base">
                <property name="parentDepartment" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="departmentDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="closeAction" type="view_close" text="msg:///actions.Close" icon="CLOSE"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="departmentDc">
            <textField id="nameField" property="name"/>
            <entityPicker id="parentDepartmentField" property="parentDepartment">
                <actions>
                    <action id="entityRead" type="entity_read"/>
                </actions>
            </entityPicker>
            <textField id="numField" property="num"/>
        </formLayout>
        <hbox id="readActions">
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
