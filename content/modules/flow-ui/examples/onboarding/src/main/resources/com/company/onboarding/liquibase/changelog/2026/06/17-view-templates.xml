<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1" author="onboarding">
        <createTable tableName="PRODUCT">
            <column name="ID" type="${uuid.type}">
                <constraints primaryKey="true" primaryKeyName="PK_PRODUCT"/>
            </column>
            <column name="VERSION" type="INT" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="NAME" type="VARCHAR(255)"/>
            <column name="PRICE" type="DECIMAL(19, 2)"/>
        </createTable>
    </changeSet>
    <changeSet id="2" author="onboarding">
        <createTable tableName="SUPPLIER">
            <column name="ID" type="${uuid.type}">
                <constraints primaryKey="true" primaryKeyName="PK_SUPPLIER"/>
            </column>
            <column name="VERSION" type="INT" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="NAME" type="VARCHAR(255)"/>
            <column name="EMAIL" type="VARCHAR(255)"/>
            <column name="PHONE" type="VARCHAR(255)"/>
            <column name="INTERNAL_NOTE" type="VARCHAR(255)"/>
            <column name="CREATED_BY" type="VARCHAR(255)"/>
            <column name="CREATED_DATE" type="DATETIME"/>
        </createTable>
    </changeSet>
    <changeSet id="3" author="onboarding">
        <createTable tableName="INVOICE">
            <column name="ID" type="${uuid.type}">
                <constraints primaryKey="true" primaryKeyName="PK_INVOICE"/>
            </column>
            <column name="VERSION" type="INT" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="NUMBER_" type="VARCHAR(255)"/>
            <column name="DATE_" type="DATE"/>
        </createTable>
    </changeSet>
    <changeSet id="4" author="onboarding">
        <createTable tableName="INVOICE_ITEM">
            <column name="ID" type="${uuid.type}">
                <constraints primaryKey="true" primaryKeyName="PK_INVOICE_ITEM"/>
            </column>
            <column name="VERSION" type="INT" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="INVOICE_ID" type="${uuid.type}">
                <constraints nullable="false"/>
            </column>
            <column name="PRODUCT_NAME" type="VARCHAR(255)"/>
            <column name="QUANTITY" type="INT"/>
            <column name="PRICE" type="DECIMAL(19, 2)"/>
        </createTable>
    </changeSet>
    <changeSet id="5" author="onboarding">
        <createIndex indexName="IDX_INVOICE_ITEM_INVOICE" tableName="INVOICE_ITEM">
            <column name="INVOICE_ID"/>
        </createIndex>
        <addForeignKeyConstraint baseColumnNames="INVOICE_ID" baseTableName="INVOICE_ITEM"
                                 constraintName="FK_INVOICE_ITEM_ON_INVOICE"
                                 referencedColumnNames="ID" referencedTableName="INVOICE"/>
    </changeSet>
</databaseChangeLog>
