<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://com.company.onboarding.view.department/departmentExpressionOrderView.title">
    <!-- tag::expression-order-view[] -->
    <data readOnly="true">
        <collection id="departmentsDc"
                    class="com.company.onboarding.entity.Department">
            <fetchPlan extends="_base"/>
            <loader id="departmentsDl">
                <query>
                    <![CDATA[select e from Department e]]>
                </query>
            </loader>
        </collection>
    </data>
    <layout>
        <dataGrid id="departmentsDataGrid"
                  width="100%"
                  dataContainer="departmentsDc">
            <columns>
                <column property="name"/>
                <column property="num"/>
            </columns>
        </dataGrid>
    </layout>
    <!-- end::expression-order-view[] -->
</view>
