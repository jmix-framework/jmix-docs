<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!-- tag::namespaces[] -->
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:aichat="http://jmix.io/schema/aichat/ui"
      title="msg://CodeBlockView.title">
    <!-- end::namespaces[] -->
    <layout>
        <vbox width="100%" maxWidth="60em" padding="false">

            <h4 text="msg://basicsSection.title"/>
            <!-- tag::basics[] -->
            <aichat:aiCodeBlock id="basicsBlock" language="sql">
                <aichat:code><![CDATA[select c.name, count(o.id) as order_count
from CUSTOMER c
    left join ORDER_ o on o.customer_id = c.id
group by c.name
order by order_count desc]]></aichat:code>
            </aichat:aiCodeBlock>
            <!-- end::basics[] -->

            <h4 text="msg://codeFromBundleSection.title"/>
            <!-- tag::code-from-bundle[] -->
            <aichat:aiCodeBlock id="bundleBlock"
                                language="bash"
                                code="msg://runCommand.code"/>
            <!-- end::code-from-bundle[] -->

            <h4 text="msg://noLanguageSection.title"/>
            <!-- tag::no-language[] -->
            <aichat:aiCodeBlock id="noLanguageBlock">
                <aichat:code><![CDATA[{
  "id": "a4f1c2e0-3b7d-4a91-8f56-2c0d9e8b1a34",
  "number": "ORD-00417",
  "amount": 149.90,
  "paid": false
}]]></aichat:code>
            </aichat:aiCodeBlock>
            <!-- end::no-language[] -->

            <h4 text="msg://highlightOffSection.title"/>
            <!-- tag::highlight-off[] -->
            <aichat:aiCodeBlock id="highlightOffBlock"
                                language="java"
                                highlight="false">
                <aichat:code><![CDATA[public Order createOrder(Customer customer) {
    Order order = dataManager.create(Order.class);
    order.setCustomer(customer);
    return dataManager.save(order);
}]]></aichat:code>
            </aichat:aiCodeBlock>
            <!-- end::highlight-off[] -->

            <h4 text="msg://actionsDisabledSection.title"/>
            <!-- tag::actions-disabled[] -->
            <aichat:aiCodeBlock id="actionsDisabledBlock"
                                language="properties"
                                copyActionEnabled="false"
                                wrapActionEnabled="false">
                <aichat:code><![CDATA[main.datasource.url=jdbc:postgresql://localhost:5432/demo
main.datasource.username=demo
jmix.core.available-locales=en,de]]></aichat:code>
            </aichat:aiCodeBlock>
            <!-- end::actions-disabled[] -->

            <h4 text="msg://programmaticSection.title"/>
            <vbox id="programmaticBox" width="100%" padding="false"/>

            <h4 text="msg://i18nSection.title"/>
            <!-- tag::i18n[] -->
            <aichat:aiCodeBlock id="i18nBlock" language="yaml">
                <aichat:code><![CDATA[services:
  db:
    image: postgres:17
    environment:
      POSTGRES_DB: demo
      POSTGRES_PASSWORD: demo]]></aichat:code>
                <aichat:i18n copy="msg://i18nBlock.copy"
                             copied="msg://i18nBlock.copied"/>
            </aichat:aiCodeBlock>
            <!-- end::i18n[] -->

            <h4 text="msg://stylingSection.title"/>
            <!-- tag::styling[] -->
            <aichat:aiCodeBlock id="styledBlock"
                                language="json"
                                classNames="tinted-code-block">
                <aichat:code><![CDATA[{
  "name": "jmix-aichat",
  "experimental": true
}]]></aichat:code>
            </aichat:aiCodeBlock>
            <!-- end::styling[] -->

        </vbox>
    </layout>
</view>
