<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:aichat="http://jmix.io/schema/aichat/ui"
      title="msg://GenerationView.title">
    <layout expand="chat">
        <hbox id="buttonsPanel" padding="false">
            <button id="stopButton" text="msg://stopButton.text" enabled="false"/>
            <button id="regenerateButton" text="msg://regenerateButton.text"/>
            <span id="stateSpan"/>
        </hbox>
        <aichat:aiChat id="chat" width="100%" height="100%">
            <!-- tag::regenerate-action[] -->
            <aichat:assistantActions>
                <aichat:action id="assistantRegenerate"
                               type="aichat_messageRegenerate"/>
            </aichat:assistantActions>
            <!-- end::regenerate-action[] -->
        </aichat:aiChat>
    </layout>
</view>
