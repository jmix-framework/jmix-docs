<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:aichat="http://jmix.io/schema/aichat/ui"
      title="msg://ChatView.title">
    <data>
        <!-- tag::data[] -->
        <collection id="messagesDc" class="com.company.demo.entity.ChatMessage">
            <fetchPlan extends="_base"/>
            <loader id="messagesDl">
                <query>
                    <![CDATA[select e from ChatMessage e order by e.createdDate]]>
                </query>
            </loader>
        </collection>
        <!-- end::data[] -->
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <layout expand="chat">
        <hbox id="buttonsPanel" padding="false">
            <!-- tag::chat-action[] -->
            <button id="clearButton" action="chat.clearAction"/>
            <!-- end::chat-action[] -->
        </hbox>
        <!-- tag::chat[] -->
        <aichat:aiChat id="chat"
                       dataContainer="messagesDc"
                       autoSave="true"
                       width="100%"
                       height="100%">
            <!-- tag::chat-action-declaration[] -->
            <aichat:actions>
                <aichat:action id="clearAction"
                               text="msg://clearAction.text"
                               icon="TRASH"/>
            </aichat:actions>
            <!-- end::chat-action-declaration[] -->
            <!-- tag::system-prompt[] -->
            <aichat:systemPrompt><![CDATA[You are the support assistant for an order management application.

Answer only questions about orders, customers and deliveries. If a question is
about anything else, say so and suggest the user contact their account manager.

Always answer in the language the question was asked in. Keep answers short:
two or three sentences unless the user asks for detail. When you refer to an
order, always include its number.

Never invent an order number, a delivery date or a price. If the answer is not
in the conversation, say that you do not have it.]]></aichat:systemPrompt>
            <!-- end::system-prompt[] -->
            <!-- tag::bands[] -->
            <aichat:inputHeader>
                <span id="contextSpan" text="msg://contextSpan.text"/>
            </aichat:inputHeader>
            <aichat:inputFooter>
                <span text="msg://disclaimer.text"/>
            </aichat:inputFooter>
            <!-- end::bands[] -->
            <!-- tag::empty-state[] -->
            <aichat:emptyStateHeader>
                <h3 text="msg://emptyStateHeader.text"/>
            </aichat:emptyStateHeader>
            <aichat:emptyStateFooter>
                <span text="msg://emptyStateFooter.text"/>
            </aichat:emptyStateFooter>
            <!-- end::empty-state[] -->
        </aichat:aiChat>
        <!-- end::chat[] -->
    </layout>
</view>
