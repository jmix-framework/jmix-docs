<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!-- tag::namespaces[] -->
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:aichat="http://jmix.io/schema/aichat/ui"
      title="msg://MessageListView.title">
<!-- end::namespaces[] -->
    <layout>
        <vbox width="100%" maxWidth="48em" padding="false">

            <h4 text="msg://transcriptSection.title"/>
            <!-- tag::basics[] -->
            <aichat:aiMessageList id="transcriptList" width="100%"/>
            <!-- end::basics[] -->
            <button id="addItemButton" text="msg://addItemButton.text"/>

            <h4 text="msg://drivingSection.title"/>
            <aichat:aiMessageList id="drivenList" width="100%">
                <!-- tag::thinking-stages[] -->
                <aichat:thinkingStages>
                    <aichat:thinkingStage delayMillis="600"
                                          text="msg://thinkingStage.thinking"/>
                    <aichat:thinkingStage delayMillis="4000"
                                          text="msg://thinkingStage.stillThinking"/>
                </aichat:thinkingStages>
                <!-- end::thinking-stages[] -->
            </aichat:aiMessageList>
            <hbox padding="false">
                <button id="generateButton" text="msg://generateButton.text"/>
                <button id="failButton" text="msg://failButton.text"/>
            </hbox>

            <h4 text="msg://customIndicatorSection.title"/>
            <aichat:aiMessageList id="customIndicatorList" width="100%">
                <!-- tag::thinking-indicator[] -->
                <aichat:thinkingIndicator>
                    <span id="customIndicator" text="msg://customIndicator.text"/>
                </aichat:thinkingIndicator>
                <!-- end::thinking-indicator[] -->
            </aichat:aiMessageList>
            <button id="toggleIndicatorButton" text="msg://toggleIndicatorButton.text"/>

            <h4 text="msg://actionsSection.title"/>
            <!-- tag::actions[] -->
            <aichat:aiMessageList id="actionsList" width="100%">
                <aichat:userActions>
                    <aichat:action id="userCopy" type="aichat_messageCopy"/>
                </aichat:userActions>
                <aichat:assistantActions>
                    <aichat:action id="assistantCopy" type="aichat_messageCopy"/>
                    <aichat:action id="reportAction"
                                   icon="FLAG"
                                   description="msg://reportAction.description"/>
                </aichat:assistantActions>
            </aichat:aiMessageList>
            <!-- end::actions[] -->

            <h4 text="msg://announceSection.title"/>
            <!-- tag::announce[] -->
            <aichat:aiMessageList id="announceList"
                                  width="100%"
                                  announceMessages="true"/>
            <!-- end::announce[] -->

            <h4 text="msg://i18nSection.title"/>
            <!-- tag::i18n[] -->
            <aichat:aiMessageList id="i18nList" width="100%">
                <aichat:i18n showMore="msg://i18nList.showMore"
                             showLess="msg://i18nList.showLess">
                    <aichat:codeBlock copy="msg://i18nList.codeCopy"/>
                </aichat:i18n>
            </aichat:aiMessageList>
            <!-- end::i18n[] -->

        </vbox>
    </layout>
</view>
