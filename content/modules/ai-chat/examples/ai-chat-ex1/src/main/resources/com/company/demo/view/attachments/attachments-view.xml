<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:aichat="http://jmix.io/schema/aichat/ui"
      title="msg://AttachmentsView.title">
    <data>
        <collection id="messagesDc" class="com.company.demo.entity.ChatMessage">
            <!-- tag::fetch-plan[] -->
            <fetchPlan extends="_base">
                <property name="attachments"/>
            </fetchPlan>
            <!-- end::fetch-plan[] -->
            <loader id="messagesDl">
                <query>
                    <![CDATA[select e from ChatMessage e order by e.createdDate]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <layout expand="chat">
        <!-- tag::limits[] -->
        <aichat:aiChat id="chat"
                       dataContainer="messagesDc"
                       autoSave="true"
                       width="100%"
                       height="100%"
                       attachmentsEnabled="true"
                       maxFiles="3"
                       maxFileSize="5242880"
                       acceptedFileExtensions=".png,.jpg,.pdf,.txt"
                       uploadDropZoneEnabled="true">
            <!-- end::limits[] -->
            <!-- tag::upload-trigger-prefix[] -->
            <aichat:inputPrefix>
                <aichat:aiUploadTrigger id="attachTrigger"
                                        text="msg://attachTrigger.text"/>
            </aichat:inputPrefix>
            <!-- end::upload-trigger-prefix[] -->
            <aichat:inputFooter>
                <!-- tag::upload-trigger-menu[] -->
                <dropdownButton id="moreButton" text="msg://moreButton.text">
                    <items>
                        <componentItem id="attachItem">
                            <aichat:aiUploadTrigger id="menuAttachTrigger"
                                                    aiChatId="chat"
                                                    text="msg://menuAttachTrigger.text"/>
                        </componentItem>
                    </items>
                </dropdownButton>
                <!-- end::upload-trigger-menu[] -->
            </aichat:inputFooter>
        </aichat:aiChat>
    </layout>
</view>
