<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        logicalFilePath="com/company/demo/liquibase/changelog/020-chat-message.xml">

    <changeSet id="1" author="ai-chat-ex1">
        <createTable tableName="CHAT_MESSAGE">
            <column name="ID" type="${uuid.type}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="VERSION" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="ROLE" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="CONTENT" type="clob"/>
            <column name="CREATED_DATE" type="datetime"/>
        </createTable>
    </changeSet>

    <changeSet id="2" author="ai-chat-ex1">
        <createTable tableName="CHAT_MESSAGE_ATTACHMENTS">
            <column name="CHAT_MESSAGE_ID" type="${uuid.type}">
                <constraints nullable="false"/>
            </column>
            <column name="ATTACHMENTS_ORDER" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="ATTACHMENTS" type="varchar(1024)"/>
        </createTable>

        <addPrimaryKey tableName="CHAT_MESSAGE_ATTACHMENTS"
                       columnNames="CHAT_MESSAGE_ID, ATTACHMENTS_ORDER"
                       constraintName="PK_CHAT_MESSAGE_ATTACHMENTS"/>

        <addForeignKeyConstraint baseTableName="CHAT_MESSAGE_ATTACHMENTS"
                                 baseColumnNames="CHAT_MESSAGE_ID"
                                 constraintName="FK_CHAT_MESSAGE_ATTACHMENTS_ON_CHAT_MESSAGE"
                                 referencedTableName="CHAT_MESSAGE"
                                 referencedColumnNames="ID"/>
    </changeSet>

</databaseChangeLog>
