<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!-- tag::namespaces[] -->
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:aichat="http://jmix.io/schema/aichat/ui"
      title="msg://MessageInputView.title">
<!-- end::namespaces[] -->
    <layout>
        <vbox width="100%" maxWidth="48em" padding="false">

            <h4 text="msg://basicsSection.title"/>
            <!-- tag::basics[] -->
            <aichat:aiMessageInput id="basicsComposer"/>
            <!-- end::basics[] -->
            <span id="lastMessageSpan"/>

            <h4 text="msg://maxRowsSection.title"/>
            <!-- tag::max-rows[] -->
            <aichat:aiMessageInput id="maxRowsComposer" maxRows="3"/>
            <!-- end::max-rows[] -->

            <h4 text="msg://enterActionSection.title"/>
            <!-- tag::enter-action[] -->
            <aichat:aiMessageInput id="newlineComposer" enterAction="NEWLINE"/>
            <!-- end::enter-action[] -->

            <h4 text="msg://slotsSection.title"/>
            <!-- tag::slots[] -->
            <aichat:aiMessageInput id="slotsComposer">
                <aichat:prefix>
                    <button id="promptLibraryButton"
                            icon="LIST"
                            themeNames="tertiary"
                            title="msg://promptLibraryButton.title"/>
                </aichat:prefix>
                <aichat:suffix>
                    <button id="clearButton"
                            icon="ERASER"
                            themeNames="tertiary"
                            title="msg://clearButton.title"/>
                </aichat:suffix>
            </aichat:aiMessageInput>
            <!-- end::slots[] -->

            <h4 text="msg://bandsSection.title"/>
            <!-- tag::bands[] -->
            <aichat:aiMessageInput id="bandsComposer">
                <aichat:header>
                    <span id="contextSpan" text="msg://contextSpan.text"/>
                </aichat:header>
                <aichat:footer>
                    <span text="msg://disclaimer.text"/>
                </aichat:footer>
            </aichat:aiMessageInput>
            <!-- end::bands[] -->

            <h4 text="msg://fixedToolbarSection.title"/>
            <!-- tag::fixed-toolbar[] -->
            <aichat:aiMessageInput id="fixedToolbarComposer"
                                   themeNames="fixed-toolbar">
                <aichat:prefix>
                    <button id="modelButton"
                            text="msg://modelButton.text"
                            themeNames="tertiary"/>
                </aichat:prefix>
            </aichat:aiMessageInput>
            <!-- end::fixed-toolbar[] -->

            <h4 text="msg://noGapSection.title"/>
            <!-- tag::no-header-footer-gap[] -->
            <aichat:aiMessageInput id="noGapComposer"
                                   themeNames="no-header-footer-gap">
                <aichat:footer>
                    <span text="msg://disclaimer.text"/>
                </aichat:footer>
            </aichat:aiMessageInput>
            <!-- end::no-header-footer-gap[] -->

            <h4 text="msg://focusSection.title"/>
            <aichat:aiMessageInput id="focusComposer"/>
            <span id="focusStatusSpan" text="msg://focusStatus.blurred"/>

            <h4 text="msg://i18nSection.title"/>
            <!-- tag::i18n[] -->
            <aichat:aiMessageInput id="i18nComposer">
                <aichat:i18n placeholder="msg://i18nComposer.placeholder"/>
            </aichat:aiMessageInput>
            <!-- end::i18n[] -->

        </vbox>
    </layout>
</view>
