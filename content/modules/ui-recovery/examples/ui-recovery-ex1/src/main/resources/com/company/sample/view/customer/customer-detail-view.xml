<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:uirec="http://jmix.io/schema/uirecovery/ui"
      title="msg://CustomerDetailView.title"
      focusComponent="form">
    <data>
        <instance id="customerDc"
                  class="com.company.sample.entity.Customer">
            <fetchPlan extends="_base"/>
            <loader/>
        </instance>
    </data>
    <!-- tag::facet-attributes[] -->
    <facets>
        <dataLoadCoordinator auto="true"/>
        <uirec:drafts id="draftsFacet" restoreMode="AUTO" minSaveInterval="10s"/>
    </facets>
    <!-- end::facet-attributes[] -->
    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="customerDc">
            <textField id="nameField" property="name"/>
            <textField id="emailField" property="email"/>
            <textField id="phoneField" property="phone"/>
            <textField id="addressField" property="address"/>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
