<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:groupg="http://jmix.io/schema/groupgrid/ui"
      title="msg://groupDataGridFilterUrlQueryParametersView.title"
      focusComponent="customersDataGrid">
    <data readOnly="true">
        <collection id="customersDc"
                    class="com.company.groupdatagridex1.entity.Customer"
                    fetchPlan="_base">
            <loader id="customersDl">
                <query>
                    <![CDATA[select e from Customer e]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <!-- tag::group-data-grid-filter[] -->
        <urlQueryParameters>
            <groupg:groupDataGridFilter component="customersDataGrid"/>
        </urlQueryParameters>
        <!-- end::group-data-grid-filter[] -->
    </facets>
    <layout>
        <!-- tag::group-data-grid-filter[] -->
        <!-- tag::column-filtering[] -->
        <groupg:groupDataGrid id="customersDataGrid"
                              width="100%"
                              minHeight="20em"
                              dataContainer="customersDc">
            <groupg:groupBy>
                <groupg:columnRef key="grade"/>
            </groupg:groupBy>
            <groupg:columns filterable="true">
                <groupg:groupColumn header="Grade"/>
                <groupg:column property="firstName"/>
                <groupg:column property="lastName"/>
                <groupg:column property="email"/>
                <groupg:column property="country"/>
                <groupg:column property="grade"/>
            </groupg:columns>
        </groupg:groupDataGrid>
        <!-- end::column-filtering[] -->
        <!-- end::group-data-grid-filter[] -->
    </layout>
</view>
